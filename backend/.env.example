# Database (Use Supabase Pooler on port 6543 for EB production)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Security & CORS
# Comma-separated list of allowed origins (e.g., https://yourdomain.com,https://www.yourdomain.com)
CORS_ORIGINS=http://localhost:5173
# The primary frontend URL for redirects (e.g., https://yourdomain.com)
FRONTEND_URL=http://localhost:5173

# AI & External Services
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
OPENROUTER_FALLBACK_MODELS=google/gemma-2-9b-it:free,meta-llama/llama-3.2-3b-instruct:free,microsoft/phi-3-mini-128k-instruct:free,qwen/qwen2.5-7b-instruct:free,nousresearch/hermes-3-llama-3.1-8b:free
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BASIC_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# Logging
LOG_LEVEL=INFO

